<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#47BBF3"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#454545"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ReadOnlyControlBrush" Color="#262626"/>
    <SolidColorBrush x:Key="ArmedGreenBrush" Color="#168039"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="SliderFillBrush" Color="#60CDFF"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#E3E3E3"/>
</ResourceDictionary>
