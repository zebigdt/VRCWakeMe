<Window x:Class="VRCWakeMe.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCWakeMe"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="12">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArmedTitle"
                           Text="Activated"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="ArmedToggle"
                          Grid.Column="1"
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Alarm"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Output device" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="DeviceCombo" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Volume" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
                    <TextBlock x:Name="VolumeLabel"
                               DockPanel.Dock="Right"
                               Width="36"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="VolumeSlider" Minimum="1" Maximum="100" Margin="12,0"/>
                </DockPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cooldown" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="CooldownBox" MaxLength="3" InputMethod.IsInputMethodEnabled="False"/>
                        <TextBlock Text="Seconds before the alarm can go off again" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duration" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="MaxDurationBox" MaxLength="3" InputMethod.IsInputMethodEnabled="False"/>
                        <TextBlock Text="Seconds for the alarm to stop automatically" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Custom sound" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SoundNameBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Focusable="False"
                             IsTabStop="False"
                             Cursor="Arrow"/>
                    <Button x:Name="BrowseSoundButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"/>
                    <Button x:Name="ClearSoundButton" Grid.Column="2" Content="Clear" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource HintText}"
                       FontSize="13"/>
        </Border>

        <Grid>
            <CheckBox x:Name="StartWithWindowsCheck"
                      Content="Start with Windows"
                      VerticalAlignment="Center"/>
            <Button x:Name="TestButton"
                    Content="Test alarm"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</Window>
