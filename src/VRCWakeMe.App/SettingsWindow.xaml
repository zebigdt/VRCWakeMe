<Window x:Class="VRCWakeMe.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCWakeMe settings"
        Height="460"
        Width="440"
        MinHeight="420"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#555">
            Arm the tray icon when you want to sleep. Someone poking WakeMe/Touched on your avatar will play a looping alarm on the device you pick below.
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Output device" FontWeight="SemiBold"/>
                <ComboBox x:Name="DeviceCombo" Margin="0,4,0,12" DisplayMemberPath="Name"/>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Volume" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Margin="12,0"/>
                </DockPanel>

                <TextBlock Text="Cooldown (seconds)" FontWeight="SemiBold"/>
                <TextBox x:Name="CooldownBox" Margin="0,4,0,12" Width="80" HorizontalAlignment="Left"/>

                <TextBlock Text="Max alarm duration (seconds)" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxDurationBox" Margin="0,4,0,12" Width="80" HorizontalAlignment="Left"/>

                <TextBlock Text="Custom sound (optional)" FontWeight="SemiBold"/>
                <DockPanel Margin="0,4,0,12">
                    <Button x:Name="BrowseSoundButton" DockPanel.Dock="Right" Content="Browse…" Padding="10,4" Margin="8,0,0,0"/>
                    <Button x:Name="ClearSoundButton" DockPanel.Dock="Right" Content="Clear" Padding="10,4"/>
                    <TextBox x:Name="SoundPathBox" IsReadOnly="True"/>
                </DockPanel>

                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,12"/>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Padding="16,6" IsDefault="True" IsCancel="True"/>
            <Button x:Name="TestButton" Content="Test alarm" Padding="16,6" Margin="0,0,8,0" HorizontalAlignment="Left"/>
        </DockPanel>
    </Grid>
</Window>
